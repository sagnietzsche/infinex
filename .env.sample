# Copy this file to .env for local development, or mirror these names in
# Railway service variables. The app reads environment variables directly.
#
# Do not commit real secrets. Leave unused provider keys blank.

# App runtime
APP_NAME=llm-gateway
LOG_LEVEL=INFO
PORT=8000

# Provider selection
# echo requires no provider token. Use openai, anthropic, gemini, google, or ollama
# when you want real provider calls.
PROVIDER=echo
PROVIDER_FALLBACK_CHAIN=

# Provider API tokens
# Required when PROVIDER or PROVIDER_FALLBACK_CHAIN includes the matching provider.
# OPENAI_API_KEY is also used by the default semantic cache embedding model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Gateway client and admin tokens
# API_KEYS enables X-API-Key checks for chat requests.
# Examples:
# API_KEYS=dev-key
# API_KEYS=dev-key,premium-key:tier=premium,slow-key:priority=low
API_KEYS=

# ADMIN_API_KEY enables /admin routes and protects them with X-Admin-Key.
ADMIN_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Response cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_EMBEDDING_DIMENSION=1536

# Batching and backpressure
BATCH_MAX_SIZE=16
BATCH_MAX_WAIT_MS=20
BATCH_QUEUE_MAX_SIZE=1024

# API key rate limits
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1.0

# Provider retry policy
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000

# Provider circuit breaker
CB_ERROR_THRESHOLD=0.5
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=30

# Shutdown behavior
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30.0

# GitHub Actions / Railway deployment
# Set RAILWAY_TOKEN as a GitHub secret, not as a Railway runtime variable.
RAILWAY_TOKEN=
RAILWAY_SERVICE=llm-gateway
RAILWAY_ENVIRONMENT=production

# k6 load test helpers
BASE_URL=http://127.0.0.1:8000
API_KEY=
